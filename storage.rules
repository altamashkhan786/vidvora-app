rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Strictly forbid direct public access to storage files.
    // Client streaming is authorized exclusively via Cloud Functions streaming proxy or short-lived signed URLs.
    match /videos/{videoId}/{allPaths=**} {
      // Direct public reads are blocked
      allow read: if false;

      // Only authenticated active administrators can upload or delete media
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
  }
}
